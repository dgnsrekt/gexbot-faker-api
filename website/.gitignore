node_modules/
.astro/

# Built site is produced by `just docs-build` (or CI) and embedded via
# //go:embed; keep only .gitkeep so the Go package compiles before a build.
dist/*
!dist/.gitkeep
dist-pages/

# Generated by scripts/sync-knowledge.mjs and scripts/gen-llms.mjs — but keep the
# hand-authored pages (landing + 404), which are not synced.
/src/content/docs/*
!/src/content/docs/index.mdx
!/src/content/docs/404.mdx
public/llms.txt
public/llms-full.txt
