---
// Brand lockup: the Reflection mark + the "GEX Faker Studio" wordmark.
// The Reflection (brand doc §01): a price line (solid) mirrored below a muted
// waterline as a broken green line — reality on top, the synthetic copy below.
// Strokes use theme vars so the mark adapts to light/dark. Styled in theme.css.
const { siteTitleHref } = Astro.locals.starlightRoute
---

<a href={siteTitleHref} class="site-title guide-lockup sl-flex" translate="no">
  <svg class="guide-mark" viewBox="0 0 96 96" aria-hidden="true" focusable="false">
    <path
      class="guide-mark__real"
      d="M14 42 L34 18 L54 36 L74 12 L84 12"
      fill="none"
      stroke-width="6"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
    <rect class="guide-mark__water" x="10" y="46.6" width="76" height="2.8" rx="1.4" />
    <path
      class="guide-mark__copy"
      d="M14 54 L34 78 L54 60 L74 84 L84 84"
      fill="none"
      stroke-width="6"
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-dasharray="9 6"
    />
  </svg>
  <span class="guide-wordmark">GEX <b>Faker</b> <span class="guide-wordmark__studio">Studio</span></span>
</a>
